# Copy this file to .env and fill in real values.
# .env itself is gitignored and must never be committed.

FLASK_APP=run.py
FLASK_ENV=development
# Set to 0 (or omit FLASK_DEBUG entirely) in production. Debug mode exposes
# an interactive Python console on unhandled errors -- remote code execution
# if it's reachable on a public URL.
FLASK_DEBUG=1

# Leave unset for local dev -- falls back to backend/instance/dha_sync.db.
# In production, set this to a Postgres connection string (e.g. Render's
# managed Postgres "Internal Database URL"). psycopg2-binary is already in
# requirements.txt to support this.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required. Generate real random values for any deployed environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value
JWT_SECRET_KEY=change-me-to-a-different-random-value

# Comma-separated list of additional frontend origins to allow, beyond the
# localhost defaults baked into app/__init__.py. Set this to your deployed
# Netlify URL, e.g.:
#   ALLOWED_ORIGINS=https://dha-sync.netlify.app
ALLOWED_ORIGINS=

# Email configuration (for the Forgot Password feature). Without these set,
# password-reset links are written to the application log instead of sent.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
